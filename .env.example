# Credencial del proveedor de modelo (OpenRouter).
# Sin esta variable el sistema opera en modo degradado: responde con la
# extraccion local del documento y no invoca a ningun modelo.
OPENROUTER_API_KEY=

# Modelo principal. Por defecto se usa uno gratuito.
WALLE_MODELO=minimax/minimax-m3.1-flash:free

# Timeout de la invocacion al proveedor y reintentos ante 429/5xx.
WALLE_TIMEOUT_SEGUNDOS=30
WALLE_REINTENTOS=1

# Umbral minimo de relevancia documental: por debajo de este valor la consulta
# se responde sin llamar al modelo.
WALLE_UMBRAL_RELEVANCIA=1.0

# Corpus documental y base de datos local.
WALLE_DATA_DIR=Data
WALLE_DB_PATH=storage/walle.db

# Trazas JSON y origenes permitidos en desarrollo.
WALLE_LOG_LEVEL=INFO
WALLE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Servir la compilacion del frontend desde la propia API (modo de un solo servicio).
# Por defecto los servicios estan separados: API en :8000 y chat en :5173.
WALLE_SERVIR_FRONTEND=false
