# URL de la API a la que llama el navegador.
#
# Por defecto es la API local del puerto 8000. El navegador la llama directamente,
# asi que el origen del frontend (http://localhost:5173) debe estar en la
# allowlist WALLE_CORS_ORIGINS de la API, que lo incluye por defecto.
VITE_API_URL=http://127.0.0.1:8000

# URL de respaldo: se usa solo si la llamada a VITE_API_URL no llega a la API
# (por ejemplo, si el build se sirve como estatico sin proxy de Vite).
VITE_API_URL_FALLBACK=http://127.0.0.1:8000
