# URL de la API que ve el navegador.
#
# Vacia (por defecto) => rutas relativas: el navegador llama a http://localhost:5173/api
# y el proxy de Vite reenvia a la API del puerto 8000. Sin peticiones entre origenes.
#
# Con valor absoluto => el navegador llama directo a la API; el origen del frontend
# debe estar en la allowlist WALLE_CORS_ORIGINS de la API.
#
# Solo para el build de produccion, si el frontend se sirve desde otro servidor.
VITE_API_URL=

# URL de respaldo: se usa solo si la peticion relativa no llega a la API
# (por ejemplo, si el build se sirve como estatico sin proxy).
VITE_API_URL_FALLBACK=http://127.0.0.1:8000
